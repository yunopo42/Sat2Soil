{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sat2soil/web", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "services/api", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
