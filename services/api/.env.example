# Sat2Soil API — environment variables
# Local: copy to services/api/.env. Render: Service → Environment. Never commit real values.

ENVIRONMENT=development
# Exact origins allowed to call the API, comma-separated. Wildcards are rejected.
CORS_ORIGINS=http://localhost:3000
# Public NASA POWER API base URL (no key required).
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api

# --- Supabase (server only) ---
# Use the SESSION POOLER string (IPv4). The "db.<ref>.supabase.co" direct host is IPv6-only on the
# free plan and is unreachable from most networks and from Render.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
SUPABASE_URL=
# Not used yet: the API talks to Postgres directly. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret for signing demo session tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_SESSION_SECRET=
