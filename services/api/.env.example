# Sat2Soil API — environment variables
# Local: copy to services/api/.env. Render: Service → Environment. Never commit real values.

ENVIRONMENT=development
# Exact origins allowed to call the API, comma-separated. Wildcards are rejected.
CORS_ORIGINS=http://localhost:3000
# Public NASA POWER API base URL (no key required).
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api

# --- Phase 3: Supabase and demo session. Leave empty until then. ---
# Postgres connection string from Supabase → Project Settings → Database. Server only.
DATABASE_URL=
SUPABASE_URL=
# Server-only secret. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret for signing demo session tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_SESSION_SECRET=
