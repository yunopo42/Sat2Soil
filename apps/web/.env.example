# Sat2Soil web — environment variables
# Local: copy this file to .env.local. Production/preview: Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are bundled into the browser. Never put a secret in them.
# The web app never talks to Supabase directly (docs/DECISIONS.md D-008), so no Supabase keys belong here.

# Base URL of the Sat2Soil API (FastAPI). Local default below; production = your Render service URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
